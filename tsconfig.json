{
	"extends": "astro/tsconfigs/strictest",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"strictNullChecks": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			},
		],
		"paths": {
			"@/*": [
				"./src/*"
			]
		}
	}
}
