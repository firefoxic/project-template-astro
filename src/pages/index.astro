---
import BaseLayout from "../layouts/base-layout.astro"

import ThePicture from "../components/the-picture.astro"

let page = {
	title: `Main Page`,
	description: `The main page`,
}
---

<BaseLayout page={page}>

	<div class="Page-Centerer">
		<h1>{page.title}</h1>

		<ThePicture class:list={[`Image`]} name="eclipse" alt="Eclipse" />
	</div>

</BaseLayout>
