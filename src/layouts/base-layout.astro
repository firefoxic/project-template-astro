---
// oxlint-disable-next-line simple-import-sort/imports
import TheFonts from "../shared/fonts/index.astro"
import "../shared/index.css"

import { normalizePath } from "../../utils/normalizePath.js"
import TheCopyright from "../components/the-copyright/index.astro"
import TheFooter from "../components/the-footer/index.astro"
import TheHeader from "../components/the-header/index.astro"
import TheLogo from "../components/the-logo/index.astro"
import TheNavigation from "../components/the-navigation/index.astro"
import ThePage from "../components/the-page/index.astro"
import { navLinks } from "../shared/data.json" with { type: "json" }

type PageMeta = {
	description: string,
	title: string,
	lang?: string,
}

let { page } = Astro.props as { page: PageMeta }
---

<!DOCTYPE html>

<html lang={page.lang || `en`}>

	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content={page.description}>
		<meta name="color-scheme" content="light dark">
		<title>{page.title}</title>
		<TheFonts />
		<link rel="icon" href={normalizePath(`/favicon.ico`)} sizes="32x32">
		<link rel="icon" href={normalizePath(`/favicon.svg`)} type="image/svg+xml">
		<link rel="manifest" href={normalizePath(`/manifest.webmanifest`)}>
		<link rel="sitemap" href={normalizePath(`/sitemap-index.xml`)}>
	</head>

	<ThePage>
		<TheHeader class:list={[`page__header`]} slot="header">
			<TheLogo class:list={[`header__logo`]} />
			<TheNavigation navLinks={navLinks} />
		</TheHeader>
		<slot />
		<TheFooter class:list={[`page__footer`]} slot="footer">
			<TheLogo class:list={[`footer__logo`]} />
			<TheCopyright class:list={[`footer__copyright`]} />
		</TheFooter>
	</ThePage>

</html>
