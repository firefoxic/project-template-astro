---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<footer class:list={[classList, `Footer`]}>
	<div class="Page-Centerer Footer-Container">
		<slot />
	</div>
</footer>

<style is:global>
.Footer {
	background: var(--ColorUI-BG_special);

	@media (width >= 640px) {
		box-sizing: border-box;
	}
}

.Footer-Container {
	display: block flex;
	justify-content: space-between;
	align-items: center;
}
</style>
