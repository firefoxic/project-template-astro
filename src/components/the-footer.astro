---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<footer class:list={[classList, `footer`]}>
	<div class="page__centerer footer__container">
		<slot />
	</div>
</footer>

<style is:global>
.footer {
	background: var(--ColorUI-BG_special);

	@media (width >= 640px) {
		box-sizing: border-box;
	}
}

.footer__container {
	display: block flex;
	justify-content: space-between;
	align-items: center;
}
</style>
