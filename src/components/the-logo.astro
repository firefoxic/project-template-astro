---
import { normalizePath } from "../../utils/normalizePath.js"

type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---


<div class:list={[classList, `logo`]}>
	<a class="logo__link" href={normalizePath(`/`)}>
		<img class="logo__image" src="/images/logo.svg" width="32" height="32" alt="Logotype">
	</a>
</div>

<style is:global>
.logo__link {
	margin-block: 0.5em;
	display: block flow-root;
	font-family: var(--FontAccent-Family);
}

.logo__image {
	display: block flow-root;
	block-size: 2lh;
	inline-size: auto;

	&::before {
		position: absolute;
		scale: 0;
	}
}
</style>
