---
import { normalizePath } from "../../utils/normalizePath.js"

type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---


<div class:list={[classList, `Logo`]}>
	<a class="Logo-Link" href={normalizePath(`/`)}>
		<img class="Logo-Image" src="/images/logo.svg" width="32" height="32" alt="Logotype">
	</a>
</div>

<style is:global>
.Logo-Link {
	margin-block: 0.5em;
	display: block flow-root;
	font-family: var(--FontAccent-Family);
}

.Logo-Image {
	display: block flow-root;
	block-size: 2lh;
	inline-size: auto;

	&::before {
		position: absolute;
		scale: 0;
	}
}
</style>
