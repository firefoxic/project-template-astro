---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<div class:list={[classList, `Copyright`]}>
	Developed by
	<a class="Copyright-Link" href="https://github.com/firefoxic">
		<span class="Copyright-Name">firefoxic</span>
	</a>
</div>

<style is:global>
.Copyright {
	font-family: var(--FontAccent-Family);
}

.Copyright-Link {
	&:hover {
		color: var(--ColorUI-Accent);
	}
}

.Copyright-Name {
	font-style: italic;
}
</style>
