---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<div class:list={[classList, `copyright`]}>
	Developed by
	<a class="copyright__link" href="https://github.com/firefoxic">
		<span class="copyright__name">firefoxic</span>
	</a>
</div>

<style is:global>
.copyright {
	font-family: var(--FontAccent-Family);
}

.copyright__link {
	&:hover {
		color: var(--ColorUI-Accent);
	}
}

.copyright__name {
	font-style: italic;
}
</style>
