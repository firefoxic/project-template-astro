---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<header class:list={[classList, `Header`]}>
	<div class="Page-Centerer Header-Container">
		<slot />
	</div>
</header>

<style is:global>
.Header {
	background: var(--ColorUI-BG_special);

	@media (width >= 640px) {
		box-sizing: border-box;
	}
}

.Header-Container {
	display: block flex;
	justify-content: space-between;
	align-items: center;
}

</style>
