---
type Props = {
	"class"?: string,
}

let { class: classList } = Astro.props
---

<header class:list={[classList, `header`]}>
	<div class="page__centerer header__container">
		<slot />
	</div>
</header>

<style is:global>
.header {
	background: var(--ColorUI-BG_special);

	@media (width >= 640px) {
		box-sizing: border-box;
	}
}

.header__container {
	display: block flex;
	justify-content: space-between;
	align-items: center;
}

</style>
