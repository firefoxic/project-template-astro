---
import { images } from "../../shared/data.json" with { type: "json" }

type ImageName = keyof typeof images

type Props = {
	"name": ImageName,
	"alt"?: string,
	"class"?: string,
	"loading"?: `lazy` | `eager`,
	"decoding"?: `async` | `auto` | `sync`,
}

let { name, class: classList, alt = ``, loading = `lazy`, decoding = `async` } = Astro.props
let { maxDensity, sizes, formats } = images[name]
---

<picture>
	{formats.map((format, formatIndex) => sizes.map(({ breakpoint = ``, width, height }, sizeIndex: number) => {
		let isLastFormat = formatIndex === formats.length - 1
		let isLastSize = sizeIndex === sizes.length - 1
		let isImgTag = isLastFormat && isLastSize
		let src = ``
		let srcset = ``

		for (let density = maxDensity; density !== 0; density--) {
			let sourceName = `${name}${breakpoint ? `~` : ``}${breakpoint}@${density}x`
			let destPath = `/images/${sourceName}.${format}`
			let descriptor = density !== 1 ? ` ${density}x` : ``

			if (isImgTag && density === 1) src = destPath
			else srcset += `${srcset ? `, ` : ``}${destPath}${descriptor}`
		}

		return isImgTag
			? (
				<img
					class:list={classList ?? ``}
					src={src}
					srcset={srcset}
					width={width}
					height={height}
					alt={alt}
					loading={loading}
					decoding={decoding}
					>
			)
			: (
				<source
					srcset={srcset}
					type={`image/${format}`}
					width={width}
					height={height}
					media={breakpoint ? `(width <= ${breakpoint}px)` : undefined}
					>
			)
	}))}
</picture>
